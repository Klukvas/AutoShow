# One file on one dealership server. Never commit a filled copy.
# Values without shell expansions; secrets stay empty in this template.
INSTALLATION_ID=
# New installations use autoflow-ID; existing servers retain their old project name.
COMPOSE_PROJECT_NAME=
STOREFRONT_THEME=current
STOREFRONT_FONT_PRESET=default
FEATURE_REVIEWS=true
HEALTH_MIN_FREE_MB=512

# Caddy site addresses. Two modes:
#   Domain (auto-HTTPS):  SITE_ADDRESS=autoflow.example.com
#                         MEDIA_ADDRESS=media.autoflow.example.com
#   IP only (plain HTTP): SITE_ADDRESS=http://157.90.x.y
#                         MEDIA_ADDRESS=http://157.90.x.y:8081
SITE_ADDRESS=autoflow.example.com
MEDIA_ADDRESS=media.autoflow.example.com

# --- Application ---
NODE_ENV=production
PORT=3000
API_PREFIX=api
# IP-only mode: http://157.90.x.y for all three below
PUBLIC_URL=https://autoflow.example.com
PUBLIC_SITE_URL=https://autoflow.example.com
CORS_ORIGINS=https://autoflow.example.com
# Behind Caddy: trust exactly one proxy hop so rate limiting sees real IPs.
TRUST_PROXY=1
LOG_LEVEL=info

# --- Database ---
DB_NAME=autoflow
DB_ADMIN_USER=autoflow_owner
DB_ADMIN_PASSWORD=
DB_APP_USER=app_user
DB_APP_PASSWORD=

# --- Redis ---
REDIS_PASSWORD=
REDIS_DB=0

# --- JWT (openssl rand -hex 32) ---
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=2592000

# --- Auth brute-force ---
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900
AUTH_LOGIN_RATE_PER_MIN=10

# --- S3 / MinIO ---
# Public endpoint: presigned PUTs from the admin browser must resolve here,
# and the signature host must match — hence the media address, not "minio".
# IP-only mode: S3_ENDPOINT=http://157.90.x.y:8081
#               S3_PUBLIC_URL=http://157.90.x.y:8081/autoflow
S3_ENDPOINT=https://media.autoflow.example.com
S3_REGION=us-east-1
S3_BUCKET=autoflow
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=https://media.autoflow.example.com/autoflow
S3_PRESIGNED_PUT_TTL=600

# --- Media ---
MEDIA_MAX_BYTES=20971520
MEDIA_ORPHAN_TTL_HOURS=24

# --- FX ---
FX_PROVIDER=static
FX_STATIC_USD_UAH=41.5
FX_STATIC_USD_EUR=0.92
FX_STATIC_EUR_UAH=45.0
FX_CACHE_TTL=3600

# --- Lead notifications (nothing to configure here) ---
# Lead alerts go to the Telegram manager chat only; it is configured in the
# admin UI, not in env: Branding -> Telegram -> "Чат для заявок"
# (site_settings.telegram.leadChatId). There is no email channel.

# --- Rate limits ---
LEAD_RATE_PER_HOUR=5
PUBLIC_API_RATE_PER_MIN=120

# --- Views ---
VIEW_DEDUP_TTL_SECONDS=600
VIEW_FLUSH_INTERVAL_SECONDS=60

# --- Photo AI key source (own_key | managed) ---
# managed: our OpenAI key, photos sold in packs via Monobank (needs MONOBANK_TOKEN,
# works even with BILLING_ENABLED=false). Unused photos never expire.
PHOTO_AI_MODE=own_key
# own_key: encrypts the owner's saved OpenAI key (base64 of 32 bytes,
# `openssl rand -base64 32`). Set once before bootstrap; changing
# it later makes the saved key unreadable and it must be entered again.
PHOTO_AI_ENCRYPTION_KEY=
PHOTO_AI_MANAGED_API_KEY=
PHOTO_AI_PACK_SIZE=
PHOTO_AI_PACK_PRICE_UAH=
PHOTO_AI_FREE_PHOTOS=0

# --- Hosting subscription (Monobank acquiring; price/terms set by us) ---
# Webhook: ${PUBLIC_URL}/api/billing/monobank/webhook. Manual extension (bank
# transfer): docker compose run --rm app npm run billing:extend:prod -- <months>
BILLING_ENABLED=false
BILLING_MONTHLY_PRICE_UAH=
BILLING_PERIOD_MONTHS=1
BILLING_REMIND_DAYS=7
BILLING_GRACE_DAYS=10
BILLING_INITIAL_PAID_UNTIL=
MONOBANK_TOKEN=

# --- Seeds (first run: docker compose run --rm app npm run seed) ---
SEED_ADMIN_EMAIL=admin@autoflow.example.com
SEED_ADMIN_PASSWORD=

# --- Frontend (server-side runtime) ---
ADMIN_COOKIE_NAME=autoflow_admin
ADMIN_COOKIE_DOMAIN=
# IP-only mode (no HTTPS): must be false, otherwise the browser drops the cookie
ADMIN_COOKIE_SECURE=true
ADMIN_COOKIE_SIGNING_KEY=

# Approved exact dependency digests: match the selected bundle dependencies.env.
# Existing installations MUST retain the image compatible with their volumes.
CADDY_IMAGE=
POSTGRES_IMAGE=
REDIS_IMAGE=
MINIO_IMAGE=
MINIO_CLIENT_IMAGE=
BACKUP_HELPER_IMAGE=

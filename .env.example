# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
PUBLIC_URL=http://localhost:3000
# Public storefront URL — used for canonical URLs, sitemap.xml and robots.txt
PUBLIC_SITE_URL=http://localhost:3001
CORRELATION_ID_HEADER=x-correlation-id
LOG_LEVEL=info
# Express trust-proxy: 'false' (direct, unspoofable socket IP), 'true', a hop
# count (e.g. 1 behind one reverse proxy), or a CIDR. Set to match your topology.
TRUST_PROXY=false

# Initial admin bootstrap (used by `npm run seed`). In production these are the
# ONLY way an admin is created; demo listings/editor are skipped when NODE_ENV=production.
SEED_ADMIN_EMAIL=admin@autoflow.example
SEED_ADMIN_PASSWORD=

# Database (admin connection: runs migrations and seeds, owns schema)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=autoflow
DB_ADMIN_USER=autoflow_owner
DB_ADMIN_PASSWORD=owner_change_me

# Database (app connection: low-privilege runtime user)
DB_APP_USER=app_user
DB_APP_PASSWORD=app_change_me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_ACCESS_SECRET=replace-with-32-bytes-of-entropy
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=replace-with-32-bytes-of-entropy
JWT_REFRESH_TTL=2592000

# Auth brute-force
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900
AUTH_LOGIN_RATE_PER_MIN=10

# S3 / MinIO
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=autoflow
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/autoflow
S3_PRESIGNED_PUT_TTL=600

# Media
MEDIA_MAX_BYTES=20971520
MEDIA_ORPHAN_TTL_HOURS=24

# FX
FX_PROVIDER=static
FX_STATIC_USD_UAH=41.5
FX_STATIC_USD_EUR=0.92
FX_STATIC_EUR_UAH=45.0
FX_CACHE_TTL=3600

# Lead notifications — nothing to configure here.
# New leads are alerted to the Telegram manager chat only, and that chat is set
# in the admin UI: Branding -> Telegram -> "Чат для заявок"
# (=> site_settings.telegram.leadChatId). There is no email channel.

# Rate limit
LEAD_RATE_PER_HOUR=5
PUBLIC_API_RATE_PER_MIN=120

# Views
VIEW_DEDUP_TTL_SECONDS=600
VIEW_FLUSH_INTERVAL_SECONDS=60

# AI credential encryption (32 random bytes, base64; backend/worker only)
PHOTO_AI_ENCRYPTION_KEY=
PHOTO_AI_MODEL=
PHOTO_AI_TIMEOUT_SECONDS=
PHOTO_AI_JOBS_PER_HOUR=
# Photo AI key source: own_key (default — the site owner saves their own OpenAI
# key in the admin UI) or managed (our key; photos are sold in packs via
# Monobank, needs MONOBANK_TOKEN). Unused photos never expire.
PHOTO_AI_MODE=
# Our OpenAI key for managed mode (secret)
PHOTO_AI_MANAGED_API_KEY=
# Photos per pack and the pack price in whole UAH (managed mode)
PHOTO_AI_PACK_SIZE=
PHOTO_AI_PACK_PRICE_UAH=
# One-time free starter photos (managed mode, default 0)
PHOTO_AI_FREE_PHOTOS=
# AI listing descriptions share the key above. Optional overrides (defaults shown):
# LISTING_AI_MODEL=gpt-6.1-sol
# LISTING_AI_TIMEOUT_SECONDS=90
# LISTING_AI_MAX_OUTPUT_TOKENS=8000
# LISTING_AI_JOBS_PER_HOUR=30
# LISTING_AI_FREE_DESCRIPTIONS=0
# Optional token prices (USD per 1M) to record a cost estimate per draft:
# LISTING_AI_INPUT_USD_PER_MTOK=
# LISTING_AI_OUTPUT_USD_PER_MTOK=

# Hosting subscription (Monobank acquiring). Price and terms are ours — the site
# owner cannot change them from the admin panel. BILLING_ENABLED=false turns the
# whole feature off (no reminders, never blocks). When true, MONOBANK_TOKEN and
# BILLING_MONTHLY_PRICE_UAH are required. Webhook URL is derived from PUBLIC_URL
# (+ /api/billing/monobank/webhook), the post-payment return from PUBLIC_SITE_URL.
BILLING_ENABLED=false
# Monthly fee, whole UAH
BILLING_MONTHLY_PRICE_UAH=
# Months bought by one payment (default 1)
BILLING_PERIOD_MONTHS=
# Days before the due date when the admin banner appears (default 7)
BILLING_REMIND_DAYS=
# Days overdue before the admin panel is blocked (default 10)
BILLING_GRACE_DAYS=
# ISO date seeding the first paid-until on first use (default: now + 1 period)
BILLING_INITIAL_PAID_UNTIL=
# Monobank acquiring X-Token (secret)
MONOBANK_TOKEN=

# Operator-owned installation controls (restart app + worker after changes).
INSTALLATION_ID=autoflow
APP_VERSION=development
STOREFRONT_THEME=current
STOREFRONT_FONT_PRESET=default
FEATURE_REVIEWS=true
HEALTH_MIN_FREE_MB=512

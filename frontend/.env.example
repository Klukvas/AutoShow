# Backend
BACKEND_INTERNAL_URL=http://localhost:3000/api

# Public assets host (CDN/MinIO/S3) — comma-separated list for next/image allowlist
NEXT_PUBLIC_MEDIA_HOSTS=

# Auth (admin)
ADMIN_COOKIE_NAME=autoflow_admin
ADMIN_COOKIE_DOMAIN=
ADMIN_COOKIE_SECURE=false
# HMAC secret for signing the admin cookie payload. Generate with:
#   openssl rand -base64 48
# MUST be set in production; tampering rejects the cookie.
ADMIN_COOKIE_SIGNING_KEY=change-me-with-openssl-rand-base64-48

# Storefront design, fixed when the app is BUILT (next build / next dev), not at runtime:
# the name of a folder in src/themes/. Leave it commented out (unset) for `current`.
# An EMPTY value is not "unset" — it fails the build, like any unknown name.
# STOREFRONT_THEME=current

# GA4 (optional, public Measurement ID: G- followed by 10 uppercase letters/digits)
# Empty/invalid = disabled. Build-time setting; see README before enabling.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Observability — placeholder
SENTRY_DSN=
